{
  "name": "fungga-wari-lab",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo run dev",
    "lint": "turbo lint",
    "lint:css": "stylelint \"packages/ui/**/*.css\" \"apps/**/*.css\"",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:ui": "pnpm --filter @workspace/ui run test:watch",
    "e2e": "playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/ui/src/types/supabase.ts"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.4",
    "@next/env": "^16.2.10",
    "@next/swc-wasm-nodejs": "16.2.10",
    "@playwright/test": "^1.59.1",
    "@supabase/supabase-js": "^2.103.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "express": "^5.2.1",
    "jose": "^6.2.2",
    "jsdom": "^29.0.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "puppeteer": "^25.3.0",
    "stripe": "^22.0.2",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^2.92.1",
    "turbo": "^2.10.5",
    "typescript": "7.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "eslint": "^10.7.0"
  }
}
